<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ComposeWellness</AssemblyName>
    <RootNamespace>ComposeWellness</RootNamespace>
    <Version>1.0.0</Version>
    <!-- No ICU dependency on the Linux host and no localized resource folders in the publish output. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ComposeWellness.Tests" />
  </ItemGroup>

</Project>
