{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true
      }
    }
  },
  "AllowedHosts": "*",
  "ComposeWellness": {
    "RootDirectory": "/opt/stacks",
    "LogDirectory": null,
    "MaxLogLines": 5000,
    "RetainedLogFiles": 20
  }
}
